{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "display": "The Ruby Group - React TypeScript configuration",

  "compilerOptions": {
    // -- Language & Target --
    // jsx: 'react-jsx' uses the automatic JSX runtime introduced in React 17.
    "jsx": "react-jsx",
    // target: 'ESNext' leaves modern syntax intact for the bundler to process based on browser targets.
    "target": "ESNext",

    // -- Modules & Resolution --
    // module: 'ESNext' allows modern bundlers (Vite, Webpack) to perform static analysis and tree-shaking.
    "module": "ESNext",
    // moduleResolution: 'Bundler' is the standard for modern bundlers, allowing extension-less imports unlike 'NodeNext'.
    "moduleResolution": "Bundler"
  }
}
