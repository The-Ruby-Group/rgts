{
  "name": "@the-ruby-group/rgts",
  "version": "0.2.0",
  "description": "Custom TypeScript configurations for ESLint, Prettier, and TypeScript, packaged for easy reuse across projects.",
  "keywords": [
    "the-ruby-group",
    "typescript",
    "eslint",
    "prettier",
    "eslint-config",
    "prettier-config"
  ],
  "homepage": "https://github.com/The-Ruby-Group/rgts#readme",
  "bugs": {
    "url": "https://github.com/The-Ruby-Group/rgts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Ruby-Group/rgts"
  },
  "license": "MIT",
  "author": "The Ruby Group <https://github.com/the-ruby-group>",
  "type": "module",
  "files": [
    "eslint.config.*.js",
    "prettier.*.js",
    "tsconfig.*.json",
    "patches"
  ],
  "scripts": {
    "clean": "rimraf node_modules bun.lock",
    "preinstall": "bunx only-allow bun",
    "prepare": "bunx husky || true",
    "prepublishOnly": "bun run test",
    "test": "eslint ."
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs}": "eslint --fix",
    "*.{ts,tsx,mts,cts}": "eslint --fix",
    "*.{json,md,yaml,yml,html,css}": "prettier --write",
    "package.json": "sort-package-json"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^4.2.3",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "typescript-eslint": "^8.58.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "sort-package-json": "^3.6.1"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "prettier": ">=3",
    "typescript": ">=6"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
