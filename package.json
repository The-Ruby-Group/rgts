{
  "name": "@the-ruby-group/rgts",
  "version": "0.1.0",
  "description": "Custom TypeScript configurations extending Google's `gts` for ESLint, Prettier, and TypeScript, packaged for easy reuse across projects.",
  "keywords": [
    "the-ruby-group",
    "typescript",
    "eslint",
    "prettier",
    "gts",
    "eslint-config",
    "prettier-config"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Ruby-Group/rgts"
  },
  "license": "MIT",
  "author": "The Ruby Group <https://github.com/the-ruby-group>",
  "files": [
    "eslint.config.*.js",
    "prettier.*.js",
    "tsconfig.*.json",
    "patches"
  ],
  "scripts": {
    "prepublishOnly": "bunx sort-package-json",
    "sort-package-json": "sort-package-json"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^1.35.0",
    "@eslint/js": "^9.22.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-n": "^17.16.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "gts": "^6.0.2",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.26.1"
  },
  "devDependencies": {
    "sort-package-json": "=2.15.1"
  },
  "peerDependencies": {
    "gts": ">=6",
    "typescript": ">=5"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
